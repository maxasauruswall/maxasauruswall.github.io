---
const links = [
  { href: "/", label: "Home" },
  { href: "/now", label: "Now" },
  { href: "/blog", label: "Blog" },
  { href: "/notes", label: "Notes" },
  { href: "/cartoons", label: "Cartoons" },
];

const current = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return current === "/";
  return current.startsWith(href);
}
---

<header class="border-b border-rule">
  <nav class="max-w-3xl mx-auto px-6 py-5 flex items-center justify-between font-sans">
    <a href="/" class="font-serif text-lg font-semibold tracking-tight text-ink hover:text-accent transition-colors">
      Max Wall
    </a>
    <ul class="flex gap-5 text-sm">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "transition-colors",
              isActive(link.href)
                ? "text-accent font-medium"
                : "text-ink-soft hover:text-accent",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
