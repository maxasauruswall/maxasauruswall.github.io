---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  date: Date;
  description?: string;
  backHref: string;
  backLabel: string;
}

const { title, date, description, backHref, backLabel } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={title} description={description}>
  <article class="max-w-3xl mx-auto px-6 py-12">
    <a
      href={backHref}
      class="font-sans text-sm text-ink-soft hover:text-accent transition-colors"
      >&larr; {backLabel}</a
    >
    <header class="mt-6 mb-10">
      <h1 class="text-3xl sm:text-4xl font-semibold leading-tight">{title}</h1>
      <p class="mt-3 font-sans text-sm text-ink-soft">
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </p>
    </header>
    <div class="prose-post font-sans text-[1.05rem] text-ink">
      <slot />
    </div>
  </article>
</BaseLayout>
